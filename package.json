{
  "name": "fractal6",
  "version": "1.0.0",
  "description": "Self-Organisation for Humans",
  "author": "Adrien Dulac",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "fractale",
    "organisation",
    "kanban",
    "graphql",
    "elm"
  ],
  "main": "public/index.html",
  "scripts": {
    "start": "npm run build && npm run dev",
    "build": "npm run build:elm-spa && npm run build:elm",
    "build:elm-spa": "elm-spa build .",
    "build:elm": "elm make src/Main.elm --output dist/elm.js",
    "dev_old": "npm run build && concurrently --raw --kill-others \"npm run js_build:watch\" \"npm run css_build:watch\" \"npm run dev:elm-spa\" \"npm run dev:elm\"",
    "dev:elm-spa": "chokidar src/Pages -c \"npm run build:elm-spa\"",
    "dev:elm": "elm-live src/Main.elm -u -d public -- --debug --output dist/elm.js",
    "mybuild": "npm run css_build && npm run js_build",
    "css_build:watch": "chokidar assets/sass/ -c \"npm run css_build\"",
    "js_build:watch": "chokidar assets/js -c \"npm run js_build\"",
    "css_build": "for k in dark; do node-sass --omit-source-map-url assets/sass/$k.scss dist/$k.css; done",
    "js_build": "cp -v assets/js/*.js dist/",
    "graphql_build": "./node_modules/.bin/elm-graphql --schema-file ./schema.gql --base Fractal --output ./src",
    "webdev": "webpack-dev-server --hot --port 8001 --mode development",
    "webprod": "webpack-dev-server --hot --port 8001 --mode production",
    "prod": "webpack --mode production",
    "dev": "webpack --mode development",
    "webpack_profile": "webpack --config webpack.profile.js"
  },
  "dependencies": {
    "@bulvar/bulma": "^0.11.24",
    "@creativebulma/bulma-badge": "^1.0.1",
    "@creativebulma/bulma-tagsinput": "^1.0.3",
    "@creativebulma/bulma-tooltip": "^1.2.0",
    "bulma": "^1.0.4",
    "bulma-modal-fx": "^1.1.1",
    "bulma-switch": "^2.0.4",
    "d3": "^7.9.0",
    "elm": "^0.19.1-6",
    "minisearch": "^7.1.2"
  },
  "devDependencies": {
    "@dillonkearns/elm-graphql": "^4.3.2",
    "autoprefixer": "^10.4.21",
    "chokidar-cli": "3.0.0",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^9.2.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "elm-live": "4.0.2",
    "elm-reloader": "^1.1.2",
    "elm-spa": "4.1.0",
    "elm-webpack-loader": "^8.0.0",
    "esbuild-loader": "^4.3.0",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.3",
    "postcss-loader": "^8.1.1",
    "postcss-safe-parser": "^7.0.1",
    "postcss-scss": "^4.0.9",
    "sass": "^1.90.0",
    "sass-loader": "^16.0.5",
    "speed-measure-webpack-plugin": "^1.5.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "uglify-js": "^3.19.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  }
}
